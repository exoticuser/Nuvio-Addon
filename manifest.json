{
  "id": "org.nuvio.streamio.addon",
  "version": "1.0.0",
  "name": "Nuvio Stream.io Bridge",
  "description": "Configurable Nuvio addon with Stream.io-style catalog, metadata, and stream handlers.",
  "logo": "https://raw.githubusercontent.com/stremio/stremio-art/main/logo.png",
  "background": "https://images.unsplash.com/photo-1478720568477-152d9b164e26?auto=format&fit=crop&w=1600&q=80",
  "types": ["movie", "series"],
  "resources": [
    {
      "name": "catalog",
      "types": ["movie", "series"],
      "idPrefixes": ["tt", "tmdb"]
    },
    {
      "name": "meta",
      "types": ["movie", "series"],
      "idPrefixes": ["tt", "tmdb"]
    },
    {
      "name": "stream",
      "types": ["movie", "series"],
      "idPrefixes": ["tt", "tmdb"]
    }
  ],
  "catalogs": [
    {
      "type": "movie",
      "id": "bridge-movies",
      "name": "Bridge Movies",
      "extra": [
        { "name": "search", "isRequired": false },
        { "name": "genre", "isRequired": false },
        { "name": "skip", "isRequired": false }
      ]
    },
    {
      "type": "series",
      "id": "bridge-series",
      "name": "Bridge Series",
      "extra": [
        { "name": "search", "isRequired": false },
        { "name": "genre", "isRequired": false },
        { "name": "skip", "isRequired": false }
      ]
    }
  ],
  "behaviorHints": {
    "configurable": true,
    "configurationRequired": false,
    "adult": false
  },
  "nuvio": {
    "providerId": "streamio-bridge",
    "compatibility": "current"
  },
  "configuration": {
    "fields": [
      {
        "key": "upstreamUrl",
        "label": "Upstream Stream.io Addon URL",
        "type": "url",
        "required": true
      },
      {
        "key": "provider",
        "label": "Provider",
        "type": "text",
        "required": false
      },
      {
        "key": "apiKey",
        "label": "API Key",
        "type": "password",
        "required": false
      }
    ]
  }
}
