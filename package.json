{
  "name": "nuvio-addon",
  "version": "1.0.0",
  "description": "Production-ready Nuvio addon with Stream.io-compatible provider pipeline",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:manifest",
    "copy:manifest": "node -e \"import('node:fs/promises').then(fs=>fs.copyFile('manifest.json','dist/manifest.json'))\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test --import tsx test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nuvio",
    "stremio",
    "addon",
    "streamio"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
